# Copy to .env and fill in. NEVER commit .env
AMD_API_KEY=your-amd-token-factory-key
# OpenAI-compatible base URL from AMD Token Factory (the app appends /chat/completions)
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# Exact model name as listed in Token Factory
AMD_MODEL=Gemma-4-31B-IT
